Subtask 3.2: Create the Deployment Driver Script
This script reads a deployment configuration file, resolves target hosts, and submits a Satellite remote execution job invocation (job_invocations) for each step, then polls the job until it completes.

cat > ~/satellite-api/deploy_software.py << 'PYEOF'
#!/usr/bin/env python3
"""
Automated Software Deployment Script
Drives Satellite remote execution job invocations from a JSON config file
"""

import argparse
import json
import os
import sys
import time

import requests
from urllib3.exceptions import InsecureRequestWarning

requests.packages.urllib3.disable_warnings(InsecureRequestWarning)


class SoftwareDeployment:
    def __init__(self, satellite_url, username, password):
        self.base_url = satellite_url.rstrip('/') + '/api/v2'
        self.auth = (username, password)
        self.headers = {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
        }

    def get_host_id(self, hostname):
        params = {'search': f'name="{hostname}"'}
        response = requests.get(
            f"{self.base_url}/hosts", auth=self.auth, headers=self.headers,
            params=params, verify=False, timeout=30
        )
        if response.status_code == 200:
            hosts = response.json().get('results', [])
            if hosts:
                return hosts[0]['id']
        return None

    def _submit_job(self, template_name, inputs, host_ids):
        job_data = {
            "job_invocation": {
                "job_template_name": template_name,
                "inputs": inputs,
                "targeting_type": "static_query",
                "search_query": f"id ^ ({','.join(map(str, host_ids))})"
            }
        }
        response = requests.post(
            f"{self.base_url}/job_invocations",
            auth=self.auth, headers=self.headers,
            data=json.dumps(job_data), verify=False, timeout=30
        )
        if response.status_code == 201:
            job = response.json()
            print(f"Job created: id={job['id']}")
            return job['id']
        else:
            print(f"Failed to create job: {response.status_code} {response.text}")
            return None

    def install_packages(self, host_ids, packages):
        return self._submit_job(
            "Package Action - Katello Script Default",
            {"action": "install", "package": " ".join(packages)},
            host_ids
        )

    def update_packages(self, host_ids, packages=None):
        return self._submit_job(
            "Package Action - Katello Script Default",
            {"action": "update", "package": " ".join(packages) if packages else ""},
            host_ids
        )

    def run_custom_command(self, host_ids, command):
        return self._submit_job(
            "Run Command - Script Default",
            {"command": command},
            host_ids
        )

    def get_job_status(self, job_id):
        response = requests.get(
            f"{self.base_url}/job_invocations/{job_id}",
            auth=self.auth, headers=self.headers, verify=False, timeout=30
        )
        if response.status_code == 200:
            job = response.json()
            return {
                'status': job.get('status_label', 'unknown'),
                'succeeded': job.get('succeeded', 0),
                'failed': job.get('failed', 0),
                'pending': job.get('pending', 0)
            }
        return None

    def wait_for_job_completion(self, job_id, timeout=180, poll_interval=10):
        print(f"Waiting for job {job_id} to complete (timeout {timeout}s)...")
        start_time = time.time()
        while time.time() - start_time < timeout:
            status = self.get_job_status(job_id)
            if status:
                print(f"  status={status['status']} succeeded={status['succeeded']} "
                      f"failed={status['failed']} pending={status['pending']}")
                if status['status'] in ('succeeded', 'failed', 'cancelled'):
                    return status['status'] == 'succeeded'
            time.sleep(poll_interval)
        print(f"Job {job_id} did not complete within {timeout} seconds")
        return False

    def deploy(self, config):
        print(f"Starting deployment: {config['name']}")
        target_hosts = []

        for hostname in config.get('hostnames', []):
            host_id = self.get_host_id(hostname)
            if host_id:
                target_hosts.append(host_id)
                print(f"Resolved host: {hostname} (ID: {host_id})")
            else:
                print(f"Host not found, skipping: {hostname}")

        if not target_hosts:
            print("No target hosts resolved. Aborting deployment.")
            return False

        print(f"Deploying to {len(target_hosts)} host(s)")

        for step in config.get('steps', []):
            print(f"\nStep: {step['name']} (type={step['type']})")

            if step['type'] == 'install_packages':
                job_id = self.install_packages(target_hosts, step.get('packages', []))
            elif step['type'] == 'update_packages':
                job_id = self.update_packages(target_hosts, step.get('packages'))
            elif step['type'] == 'run_command':
                job_id = self.run_custom_command(target_hosts, step['command'])
            else:
                print(f"Unknown step type '{step['type']}', skipping")
                continue

            if not job_id:
                print(f"Could not create job for step '{step['name']}'")
                if step.get('critical', False):
                    print("Critical step failed to submit. Stopping deployment.")
                    return False
                continue

            success = self.wait_for_job_completion(job_id)
            if success:
                print(f"Step '{step['name']}' completed successfully")
            else:
                print(f"Step '{step['name']}' did not complete successfully")
                if step.get('critical', False):
                    print("Critical step failed. Stopping deployment.")
                    return False

        print(f"\nDeployment '{config['name']}' finished")
        return True


def main():
    parser = argparse.ArgumentParser(description='Automated software deployment via Satellite API')
    parser.add_argument('--config', required=True, help='Deployment configuration file (JSON)')
    args = parser.parse_args()

    satellite_url = os.getenv('SATELLITE_URL', 'https://satellite.example.com')
    satellite_user = os.getenv('SATELLITE_USER', 'admin')
    satellite_password = os.getenv('SATELLITE_PASSWORD', 'redhat123')

    deploy_client = SoftwareDeployment(satellite_url, satellite_user, satellite_password)

    try:
        with open(args.config, 'r') as f:
            config = json.load(f)
    except FileNotFoundError:
        print(f"Configuration file '{args.config}' not found")
        sys.exit(1)
    except json.JSONDecodeError as exc:
        print(f"Invalid JSON in configuration file: {exc}")
        sys.exit(1)

    success = deploy_client.deploy(config)
    sys.exit(0 if success else 1)


if __name__ == "__main__":
    main()
