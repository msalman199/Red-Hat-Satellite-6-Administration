Task 2: Automate Host Registration Using the API
Subtask 2.1: Create a Host Lookup and Registration Script
This script demonstrates how automation would look up supporting objects (organization, location) and create a host record. Save the complete file as shown.

cat > ~/satellite-api/host_registration.py << 'PYEOF'
#!/usr/bin/env python3
"""
Automated Host Registration Script
Registers hosts with Red Hat Satellite using the API
"""

import argparse
import json
import os
import sys

import requests
from urllib3.exceptions import InsecureRequestWarning

requests.packages.urllib3.disable_warnings(InsecureRequestWarning)


class HostRegistration:
    def __init__(self, satellite_url, username, password):
        self.base_url = satellite_url.rstrip('/') + '/api/v2'
        self.auth = (username, password)
        self.headers = {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
        }

    def _find_by_name(self, endpoint, name):
        params = {'search': f'name="{name}"'}
        response = requests.get(
            f"{self.base_url}/{endpoint}",
            auth=self.auth, headers=self.headers,
            params=params, verify=False, timeout=30
        )
        if response.status_code == 200:
            results = response.json().get('results', [])
            if results:
                return results[0]['id']
        return None

    def get_organization_id(self, org_name):
        return self._find_by_name('organizations', org_name)

    def get_location_id(self, location_name):
        return self._find_by_name('locations', location_name)

    def get_hostgroup_id(self, hostgroup_name):
        return self._find_by_name('hostgroups', hostgroup_name)

    def register_host(self, hostname, ip_address, mac_address,
                       org_name, location_name, hostgroup_name=None):
        org_id = self.get_organization_id(org_name)
        location_id = self.get_location_id(location_name)

        if not org_id:
            print(f"Organization '{org_name}' not found")
            return False
        if not location_id:
            print(f"Location '{location_name}' not found")
            return False

        host_data = {
            "host": {
                "name": hostname,
                "ip": ip_address,
                "mac": mac_address,
                "organization_id": org_id,
                "location_id": location_id,
                "managed": True,
                "build": False
            }
        }

        if hostgroup_name:
            hostgroup_id = self.get_hostgroup_id(hostgroup_name)
            if hostgroup_id:
                host_data["host"]["hostgroup_id"] = hostgroup_id
            else:
                print(f"Hostgroup '{hostgroup_name}' not found, continuing without it")

        response = requests.post(
            f"{self.base_url}/hosts",
            auth=self.auth, headers=self.headers,
            data=json.dumps(host_data), verify=False, timeout=30
        )

        if response.status_code == 201:
            host_info = response.json()
            print(f"Host '{hostname}' registered successfully")
            print(f"  Host ID: {host_info['id']}")
            print(f"  Name: {host_info['name']}")
            return True
        else:
            print(f"Failed to register host '{hostname}': {response.status_code} {response.text}")
            return False

    def bulk_register_hosts(self, hosts_file):
        registered = 0
        failed = 0
        with open(hosts_file, 'r') as f:
            header = f.readline()  # skip header line
            for line_num, line in enumerate(f, 2):
                line = line.strip()
                if not line or line.startswith('#'):
                    continue
                parts = [p.strip() for p in line.split(',')]
                if len(parts) != 6:
                    print(f"Invalid format on line {line_num}: {line}")
                    failed += 1
                    continue
                hostname, ip_address, mac_address, org_name, location_name, hostgroup_name = parts
                print(f"\nRegistering host from line {line_num}: {hostname}")
                success = self.register_host(
                    hostname, ip_address, mac_address, org_name, location_name,
                    hostgroup_name if hostgroup_name else None
                )
                if success:
                    registered += 1
                else:
                    failed += 1
        print(f"\nBulk registration complete: {registered} succeeded, {failed} failed")
        return failed == 0


def main():
    parser = argparse.ArgumentParser(description='Automate host registration with Satellite')
    parser.add_argument('--hostname', help='Single host to register')
    parser.add_argument('--ip', help='IP address of the host')
    parser.add_argument('--mac', help='MAC address of the host')
    parser.add_argument('--org', help='Organization name')
    parser.add_argument('--location', help='Location name')
    parser.add_argument('--hostgroup', help='Hostgroup name (optional)')
    parser.add_argument('--bulk-file', help='CSV file for bulk registration')

    args = parser.parse_args()

    satellite_url = os.getenv('SATELLITE_URL', 'https://satellite.example.com')
    satellite_user = os.getenv('SATELLITE_USER', 'admin')
    satellite_password = os.getenv('SATELLITE_PASSWORD', 'redhat123')

    reg_client = HostRegistration(satellite_url, satellite_user, satellite_password)

    if args.bulk_file:
        print(f"Starting bulk host registration from {args.bulk_file}")
        success = reg_client.bulk_register_hosts(args.bulk_file)
        sys.exit(0 if success else 1)
    elif args.hostname and args.ip and args.mac and args.org and args.location:
        print(f"Registering single host: {args.hostname}")
        success = reg_client.register_host(
            args.hostname, args.ip, args.mac,
            args.org, args.location, args.hostgroup
        )
        sys.exit(0 if success else 1)
    else:
        print("Provide either single host parameters or --bulk-file")
        parser.print_help()
        sys.exit(2)


if __name__ == "__main__":
    main()
PYEOF

